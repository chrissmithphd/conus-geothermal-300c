# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/

# Data files (too large for git)
data/raw/stanford/*.json
data/raw/smu/images/*.png
data/processed/*.csv
data/processed/*.parquet
data/processed/smu_digitized/*.csv
data/processed/smu_digitized/*.parquet

# ...but keep the small audit/summary tables + compact parquet copies so a
# reader can check the headline numbers and pull the full data without
# rerunning the pipeline. The giant redundant .csv dumps stay ignored
# (regenerable via digitize_all_smu_maps.py / calculate_depth_to_300c.py).
!data/processed/depth_bin_area_stats.csv
!data/processed/energy_generation_potential.csv
!data/processed/coal_plants_with_geothermal.csv
!data/processed/coal_geothermal_top_candidates.csv
!data/processed/conus_depth_to_300c.parquet
!data/processed/smu_digitized/smu_digitized_all_depths.parquet

# Keep directory structure but not large files
!data/raw/stanford/.gitkeep
!data/raw/smu/.gitkeep
!data/processed/.gitkeep

# Logs and temporary files
*.log
*.tmp
.DS_Store
.vscode/
.idea/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Task outputs
/tmp/

# Keep manifests and metadata
!data/raw/stanford/manifest.json
!data/raw/smu/manifest.json

# Documentation (keep these)
!docs/
!*.md

# Plots (keep these - they're for the README)
!plots/*.png

# Scripts (keep these)
!*.py

# Keep sample data or small files if needed
# (add specific exceptions here)

# superseded map-rendering experiments (v4 is the one the README uses)
create_final_maps_v2.py
create_final_maps_v3.py
plots/depth_to_300c_heatmap_v2.png
plots/depth_to_300c_heatmap_v3.png
plots/depth_to_300c_points_states_v2.png
plots/depth_to_300c_points_v3.png
